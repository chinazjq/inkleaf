{
  "name": "inkleaf",
  "version": "0.1.0",
  "private": true,
  "description": "Inkleaf (墨页) — a calm Markdown reader and editor for Windows",
  "keywords": [
    "markdown",
    "reader",
    "editor",
    "tauri",
    "windows",
    "codemirror",
    "katex",
    "mermaid"
  ],
  "author": "Inkleaf contributors",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:web": "node web/build.mjs",
    "watch:web": "node web/build.mjs --watch",
    "test": "node --test web/test/*.test.mjs",
    "licenses": "node scripts/third-party-licenses.mjs",
    "tauri": "tauri",
    "build": "tauri build",
    "dev": "tauri dev",
    "release": "node scripts/build-release.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.18",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "jsdom": "^31.0.1",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.3.0"
  }
}
